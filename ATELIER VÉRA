<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ATELIER VÉRA | Autumn / Winter 2026 Luxury Fashion</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cormorant Garamond (Serif) & Plus Jakarta Sans (Sans-Serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Tailwind Custom Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        alabaster: '#FAF8F5',
                        warmStone: '#F2EEE8',
                        obsidian: '#141414',
                        charcoal: '#262626',
                        mutedInk: '#6B665F',
                        gold: '#C5A065',
                        goldDark: '#A8844A',
                        terracotta: '#8E3B2E',
                        terracottaLight: '#F9ECEA'
                    },
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-alabaster text-obsidian font-sans antialiased selection:bg-gold selection:text-white overflow-x-hidden">

    <!-- ==========================================
         1. TOP PROMOTIONAL OFFER TICKER BAR
    =========================================== -->
    <div class="bg-obsidian text-alabaster text-[10px] sm:text-xs tracking-[0.22em] uppercase py-2.5 px-4 text-center font-medium border-b border-white/10">
        <span>COMPLIMENTARY EXPRESS SHIPPING ON ORDERS OVER $200 &bull; AUTUMN/WINTER COLLECTION LIVE &bull; USE CODE </span>
        <button onclick="copyPromoCode()" class="underline decoration-gold underline-offset-4 text-gold hover:text-white transition-colors font-semibold cursor-pointer" title="Click to copy code">
            VERA20
        </button>
        <span> FOR 20% OFF</span>
    </div>

    <!-- ==========================================
         2. STICKY GLASSMORPHIC NAVIGATION BAR
    =========================================== -->
    <header id="navbar" class="sticky top-0 z-40 bg-alabaster/90 backdrop-blur-md border-b border-obsidian/10 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-20 flex items-center justify-between">
            <!-- Brand Mark -->
            <a href="#hero" class="flex items-center gap-3 group focus:outline-none">
                <span class="w-8 h-8 rounded-full border border-obsidian/30 group-hover:border-gold flex items-center justify-center text-obsidian group-hover:text-gold transition-colors">
                    <span class="font-serif italic text-lg font-semibold">V</span>
                </span>
                <div class="flex flex-col">
                    <span class="font-serif text-2xl sm:text-[26px] tracking-[0.18em] font-semibold text-obsidian leading-none">ATELIER VÉRA</span>
                    <span class="text-[9px] tracking-[0.34em] uppercase text-mutedInk mt-1">Paris &bull; Milan</span>
                </div>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="hidden lg:flex items-center gap-8 text-xs uppercase tracking-[0.2em] font-medium text-charcoal">
                <a href="#catalog" onclick="filterByCategory('all')" class="hover:text-goldDark transition-colors py-2">New Arrivals</a>
                <a href="#collections" class="hover:text-goldDark transition-colors py-2">Collections</a>
                <a href="#categories" class="hover:text-goldDark transition-colors py-2">Categories</a>
                <a href="#offers" class="text-terracotta hover:opacity-80 transition-opacity py-2 font-semibold">Offers</a>
                <a href="#collections" class="hover:text-goldDark transition-colors py-2">Lookbook</a>
            </nav>

            <!-- Right Utility Icons: Search, Wishlist, Shopping Bag -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Search Jump Toggle -->
                <button 
                    onclick="focusCatalogSearch()" 
                    aria-label="Search Catalog"
                    class="p-2.5 rounded-full hover:bg-warmStone text-obsidian transition-colors"
                >
                    <i data-lucide="search" class="w-5 h-5"></i>
                </button>

                <!-- Wishlist Drawer Trigger -->
                <button 
                    id="wishlist-trigger"
                    onclick="openWishlistDrawer()"
                    aria-label="Open Wishlist"
                    class="relative p-2.5 rounded-full hover:bg-warmStone text-obsidian transition-colors"
                >
                    <i data-lucide="heart" class="w-5 h-5"></i>
                    <span id="wishlist-badge" class="absolute top-1 right-1 w-4 h-4 rounded-full bg-gold text-white text-[10px] font-bold flex items-center justify-center">0</span>
                </button>

                <!-- Shopping Bag Drawer Trigger -->
                <button 
                    id="bag-trigger"
                    onclick="openBagDrawer()"
                    aria-label="Open Shopping Bag"
                    class="relative flex items-center gap-2 px-3.5 py-2 rounded-full bg-obsidian hover:bg-charcoal text-white text-xs uppercase tracking-wider font-medium transition-colors"
                >
                    <i data-lucide="shopping-bag" class="w-4 h-4 text-gold"></i>
                    <span class="hidden sm:inline">Bag</span>
                    <span id="bag-badge" class="w-5 h-5 rounded-full bg-gold text-obsidian text-[11px] font-bold flex items-center justify-center">0</span>
                </button>

                <!-- Mobile Menu Toggle -->
                <button id="mobile-menu-btn" aria-label="Toggle Menu" class="lg:hidden p-2 rounded-lg text-obsidian hover:bg-warmStone transition-colors">
                    <i data-lucide="menu" id="mobile-open-icon" class="w-6 h-6"></i>
                    <i data-lucide="x" id="mobile-close-icon" class="w-6 h-6 hidden"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Drawer -->
        <div id="mobile-menu" class="hidden lg:hidden bg-alabaster border-t border-obsidian/10 px-6 pt-4 pb-8">
            <nav class="flex flex-col space-y-3 text-xs uppercase tracking-[0.2em] font-medium text-obsidian">
                <a href="#catalog" onclick="closeMobileMenu(); filterByCategory('all')" class="py-2.5 border-b border-obsidian/5">New Arrivals</a>
                <a href="#collections" onclick="closeMobileMenu()" class="py-2.5 border-b border-obsidian/5">Collections</a>
                <a href="#categories" onclick="closeMobileMenu()" class="py-2.5 border-b border-obsidian/5">Categories</a>
                <a href="#offers" onclick="closeMobileMenu()" class="py-2.5 border-b border-obsidian/5 text-terracotta font-semibold">Seasonal Offers</a>
                <a href="#collections" onclick="closeMobileMenu()" class="py-2.5">Lookbook</a>
            </nav>
        </div>
    </header>

    <!-- ==========================================
         3. FULL-BLEED EDITORIAL HERO SECTION
    =========================================== -->
    <section id="hero" class="relative min-h-[86vh] flex items-center overflow-hidden bg-obsidian">
        <!-- Editorial Runway/Studio Backdrop -->
        <div class="absolute inset-0 z-0">
            <img 
                src="https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=2000&q=85" 
                alt="ATELIER VÉRA Autumn Winter 2026 Runway Editorial" 
                onerror="this.src='https://placehold.co/1920x1080/141414/C5A065?text=ATELIER+VERA+AW26'"
                class="w-full h-full object-cover object-center opacity-80"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-obsidian/90 via-obsidian/55 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian/70 via-transparent to-obsidian/30"></div>
        </div>

        <!-- Hero Content -->
        <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-24 w-full">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-gold text-xs uppercase tracking-[0.28em] font-medium mb-6">
                    <span>Autumn / Winter 2026</span>
                </div>
                <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-[82px] text-white font-normal leading-[1.03] tracking-tight mb-6">
                    Sculpted Silhouettes for <span class="italic text-gold">Modern Dressing</span>
                </h1>
                <p class="text-stone-200 text-base sm:text-lg font-light leading-relaxed max-w-xl mb-10">
                    Architectural tailoring, double-faced Mongolian cashmere, and fluid heavyweight silks crafted in small atelier editions.
                </p>
                <div class="flex flex-col sm:flex-row items-center gap-4">
                    <a href="#catalog" onclick="filterByCategory('all')" class="w-full sm:w-auto px-8 py-4 rounded-full bg-alabaster text-obsidian hover:bg-gold hover:text-white text-xs uppercase tracking-[0.22em] font-semibold text-center transition-all duration-300 shadow-xl">
                        Shop New Arrivals
                    </a>
                    <a href="#collections" class="w-full sm:w-auto px-8 py-4 rounded-full border border-white/40 text-white hover:border-gold hover:text-gold backdrop-blur-sm text-xs uppercase tracking-[0.22em] font-semibold text-center transition-all duration-300">
                        Explore Collections
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================
         4. CLOTHING CATEGORIES GRID (5 VISUAL CARDS)
    =========================================== -->
    <section id="categories" class="py-20 md:py-28 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
            <div>
                <span class="text-goldDark uppercase tracking-[0.28em] text-xs font-semibold">Curated Departments</span>
                <h2 class="font-serif text-4xl sm:text-5xl text-obsidian font-normal mt-2">Shop by Category</h2>
            </div>
            <p class="text-mutedInk text-sm max-w-md font-light">
                Select a wardrobe pillar below to filter our seasonal pieces immediately.
            </p>
        </div>

        <!-- 5 Visual Category Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
            <!-- Category 1: Women -->
            <button onclick="filterByCategory('Women', true)" class="group relative h-72 sm:h-80 rounded-2xl overflow-hidden text-left shadow-sm focus:outline-none">
                <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=700&q=80" alt="Women's Collection" onerror="this.src='https://placehold.co/600x800/141414/C5A065?text=Women'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-obsidian/85 via-obsidian/20 to-transparent"></div>
                <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between text-white">
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.24em] text-gold">01</p>
                        <h3 class="font-serif text-2xl mt-0.5">Women</h3>
                    </div>
                    <i data-lucide="arrow-up-right" class="w-4 h-4 text-gold group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"></i>
                </div>
            </button>

            <!-- Category 2: Men -->
            <button onclick="filterByCategory('Men', true)" class="group relative h-72 sm:h-80 rounded-2xl overflow-hidden text-left shadow-sm focus:outline-none">
                <img src="https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=700&q=80" alt="Men's Collection" onerror="this.src='https://placehold.co/600x800/141414/C5A065?text=Men'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-obsidian/85 via-obsidian/20 to-transparent"></div>
                <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between text-white">
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.24em] text-gold">02</p>
                        <h3 class="font-serif text-2xl mt-0.5">Men</h3>
                    </div>
                    <i data-lucide="arrow-up-right" class="w-4 h-4 text-gold group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"></i>
                </div>
            </button>

            <!-- Category 3: Outerwear -->
            <button onclick="filterByCategory('Outerwear', true)" class="group relative h-72 sm:h-80 rounded-2xl overflow-hidden text-left shadow-sm focus:outline-none">
                <img src="https://images.unsplash.com/photo-1539533018447-63fcce2678e3?auto=format&fit=crop&w=700&q=80" alt="Outerwear Collection" onerror="this.src='https://placehold.co/600x800/141414/C5A065?text=Outerwear'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-obsidian/85 via-obsidian/20 to-transparent"></div>
                <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between text-white">
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.24em] text-gold">03</p>
                        <h3 class="font-serif text-2xl mt-0.5">Outerwear</h3>
                    </div>
                    <i data-lucide="arrow-up-right" class="w-4 h-4 text-gold group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"></i>
                </div>
            </button>

            <!-- Category 4: Knitwear -->
            <button onclick="filterByCategory('Knitwear', true)" class="group relative h-72 sm:h-80 rounded-2xl overflow-hidden text-left shadow-sm focus:outline-none">
                <img src="https://images.unsplash.com/photo-1576566588028-4147f3842f27?auto=format&fit=crop&w=700&q=80" alt="Knitwear Collection" onerror="this.src='https://placehold.co/600x800/141414/C5A065?text=Knitwear'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-obsidian/85 via-obsidian/20 to-transparent"></div>
                <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between text-white">
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.24em] text-gold">04</p>
                        <h3 class="font-serif text-2xl mt-0.5">Knitwear</h3>
                    </div>
                    <i data-lucide="arrow-up-right" class="w-4 h-4 text-gold group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"></i>
                </div>
            </button>

            <!-- Category 5: Accessories -->
            <button onclick="filterByCategory('Accessories', true)" class="col-span-2 sm:col-span-1 group relative h-72 sm:h-80 rounded-2xl overflow-hidden text-left shadow-sm focus:outline-none">
                <img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=700&q=80" alt="Accessories Collection" onerror="this.src='https://placehold.co/600x800/141414/C5A065?text=Accessories'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-obsidian/85 via-obsidian/20 to-transparent"></div>
                <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between text-white">
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.24em] text-gold">05</p>
                        <h3 class="font-serif text-2xl mt-0.5">Accessories</h3>
                    </div>
                    <i data-lucide="arrow-up-right" class="w-4 h-4 text-gold group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"></i>
                </div>
            </button>
        </div>
    </section>

    <!-- ==========================================
         5. FEATURED COLLECTIONS SHOWCASE (2 SPLIT CARDS)
    =========================================== -->
    <section id="collections" class="py-12 md:py-20 bg-warmStone border-y border-obsidian/10">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
            <div class="text-center max-w-2xl mx-auto mb-14">
                <span class="text-goldDark uppercase tracking-[0.28em] text-xs font-semibold">Editorial Lookbook</span>
                <h2 class="font-serif text-4xl sm:text-5xl text-obsidian font-normal mt-2">Featured Capsules</h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Capsule 1: The Cashmere & Wool Edit -->
                <div class="group relative h-[480px] sm:h-[540px] rounded-2xl overflow-hidden shadow-lg">
                    <img 
                        src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1200&q=85" 
                        alt="The Cashmere & Wool Edit" 
                        onerror="this.src='https://placehold.co/1000x800/141414/C5A065?text=Cashmere+%26+Wool+Edit'"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-obsidian/90 via-obsidian/35 to-transparent"></div>
                    <div class="absolute bottom-8 left-8 right-8 sm:bottom-10 sm:left-10 sm:right-10 text-white">
                        <span class="text-gold uppercase tracking-[0.26em] text-[11px] font-semibold">Capsule 01 &bull; Tactile Warmth</span>
                        <h3 class="font-serif text-3xl sm:text-4xl mt-2 mb-3">The Cashmere &amp; Wool Edit</h3>
                        <p class="text-stone-200 text-sm font-light max-w-md mb-6 leading-relaxed">
                            Unbleached Inner Mongolian cashmere knits and hand-finished virgin wool coats engineered for effortless layering.
                        </p>
                        <button 
                            onclick="filterByCollection('cashmere-wool')"
                            class="px-7 py-3.5 rounded-full bg-white text-obsidian hover:bg-gold hover:text-white text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-300"
                        >
                            Shop Collection
                        </button>
                    </div>
                </div>

                <!-- Capsule 2: Evening Tailoring & Silk -->
                <div class="group relative h-[480px] sm:h-[540px] rounded-2xl overflow-hidden shadow-lg">
                    <img 
                        src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1200&q=85" 
                        alt="Evening Tailoring & Silk" 
                        onerror="this.src='https://placehold.co/1000x800/141414/C5A065?text=Evening+Tailoring+%26+Silk'"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-obsidian/90 via-obsidian/35 to-transparent"></div>
                    <div class="absolute bottom-8 left-8 right-8 sm:bottom-10 sm:left-10 sm:right-10 text-white">
                        <span class="text-gold uppercase tracking-[0.26em] text-[11px] font-semibold">Capsule 02 &bull; Nocturne</span>
                        <h3 class="font-serif text-3xl sm:text-4xl mt-2 mb-3">Evening Tailoring &amp; Silk</h3>
                        <p class="text-stone-200 text-sm font-light max-w-md mb-6 leading-relaxed">
                            Sharp peak-lapel blazers, liquid charmeuse slip dresses, and sculpted leather accessories for after-hours elegance.
                        </p>
                        <button 
                            onclick="filterByCollection('evening-silk')"
                            class="px-7 py-3.5 rounded-full bg-white text-obsidian hover:bg-gold hover:text-white text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-300"
                        >
                            Shop Collection
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================
         6. INTERACTIVE PRODUCT CATALOG & SHOPPING SECTION
    =========================================== -->
    <section id="catalog" class="py-20 md:py-28 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <!-- Header & Search Bar -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 gap-6">
            <div>
                <span class="text-goldDark uppercase tracking-[0.28em] text-xs font-semibold">Autumn / Winter 2026</span>
                <h2 id="catalog-heading" class="font-serif text-4xl sm:text-5xl text-obsidian font-normal mt-2">
                    The Seasonal Edit
                </h2>
            </div>

            <!-- Inline Catalog Search Input -->
            <div class="relative w-full lg:w-80">
                <i data-lucide="search" class="w-4 h-4 text-mutedInk absolute left-4 top-1/2 -translate-y-1/2"></i>
                <input 
                    type="text" 
                    id="catalog-search" 
                    placeholder="Search garments, fabrics..." 
                    class="w-full pl-11 pr-4 py-3 rounded-full bg-white border border-obsidian/15 text-sm text-obsidian placeholder-mutedInk focus:outline-none focus:border-gold transition-colors"
                />
            </div>
        </div>

        <!-- Filter Pills, Offer Toggle & Sort Toolbar -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-obsidian/10 shadow-sm mb-10 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <!-- Category Pills -->
            <div id="category-pills" class="flex flex-wrap items-center gap-2">
                <button data-cat="all" class="cat-pill px-4 py-2 rounded-full text-xs uppercase tracking-wider font-semibold bg-obsidian text-white transition-all">All</button>
                <button data-cat="Women" class="cat-pill px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium bg-alabaster text-charcoal hover:bg-warmStone transition-all">Women</button>
                <button data-cat="Men" class="cat-pill px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium bg-alabaster text-charcoal hover:bg-warmStone transition-all">Men</button>
                <button data-cat="Outerwear" class="cat-pill px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium bg-alabaster text-charcoal hover:bg-warmStone transition-all">Outerwear</button>
                <button data-cat="Knitwear" class="cat-pill px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium bg-alabaster text-charcoal hover:bg-warmStone transition-all">Knitwear</button>
                <button data-cat="Accessories" class="cat-pill px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium bg-alabaster text-charcoal hover:bg-warmStone transition-all">Accessories</button>
            </div>

            <!-- Right Controls: On Offer Only Toggle & Sort Dropdown -->
            <div class="flex flex-wrap items-center gap-3 sm:gap-4 justify-between lg:justify-end border-t lg:border-t-0 pt-3 lg:pt-0 border-obsidian/10">
                <!-- Offer/Sale Toggle -->
                <label class="inline-flex items-center gap-2.5 cursor-pointer select-none">
                    <input type="checkbox" id="offer-only-toggle" class="sr-only peer" />
                    <div class="w-10 h-5 bg-stone-300 peer-checked:bg-terracotta rounded-full relative transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:w-4 after:h-4 after:rounded-full after:transition-transform peer-checked:after:translate-x-5"></div>
                    <span class="text-xs uppercase tracking-wider font-semibold text-terracotta">On Offer Only</span>
                </label>

                <!-- Sort Dropdown -->
                <div class="relative">
                    <select id="catalog-sort" aria-label="Sort Products" class="pl-4 pr-9 py-2 rounded-full bg-alabaster border border-obsidian/15 text-xs uppercase tracking-wider font-medium text-obsidian focus:outline-none focus:border-gold appearance-none cursor-pointer">
                        <option value="featured">Sort: Featured</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="bestseller">Best Sellers</option>
                    </select>
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-mutedInk absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                </div>
            </div>
        </div>

        <!-- Active Filter Feedback Strip -->
        <div class="flex items-center justify-between mb-6 text-xs text-mutedInk">
            <span id="product-count-label">Showing 10 Pieces</span>
