                                onerror="this.src='https://placehold.co/600x800/F2EEE8/141414?text=${encodeURIComponent(p.title)}'"
                                class="w-full h-full object-cover transition-opacity duration-500 group-hover:opacity-0"
                            />
                            <img 
                                src="${p.images[1] || p.images[0]}" 
                                alt="${p.title} alternate view" 
                                loading="lazy"
                                class="w-full h-full object-cover absolute inset-0 opacity-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                            />

                            <!-- Top Left Tag Badge -->
                            <span class="absolute top-3.5 left-3.5 px-3 py-1 rounded-full text-[10px] uppercase tracking-widest font-bold ${badgeStyle}">
