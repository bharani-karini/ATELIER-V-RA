        const clearFiltersBtn = document.getElementById('clear-filters-btn');
        const catalogEmpty = document.getElementById('catalog-empty');
        const catalogHeading = document.getElementById('catalog-heading');

        function renderCatalog() {
            const query = catalogSearch.value.trim().toLowerCase();
            const offerOnly = offerOnlyToggle.checked;
            const sortBy = catalogSort.value;

            let filtered = products.filter(p => {
                const matchesCat = activeCategory === 'all' || p.category === activeCategory;
                const matchesCol = !activeCollection || p.collection === activeCollection;
                const matchesOffer = !offerOnly || p.isOffer;
                const matchesQuery = !query || 
                    p.title.toLowerCase().includes(query) ||
                    p.fabric.toLowerCase().includes(query) ||
                    p.category.toLowerCase().includes(query);
                return matchesCat && matchesCol && matchesOffer && matchesQuery;
            });

            if (sortBy === 'price-asc') {
                filtered.sort((a, b) => a.price - b.price);
            } else if (sortBy === 'price-desc') {
                filtered.sort((a, b) => b.price - a.price);
            } else if (sortBy === 'bestseller') {
                filtered.sort((a, b) => (b.bestseller ? 1 : 0) - (a.bestseller ? 1 : 0));
            }

            // Update count & reset button visibility
            productCountLabel.textContent = `Showing ${filtered.length} ${filtered.length === 1 ? 'Piece' : 'Pieces'}`;
            const isFiltered = activeCategory !== 'all' || activeCollection !== null || offerOnly || query !== '';
            clearFiltersBtn.classList.toggle('hidden', !isFiltered);

            if (activeCollection === 'cashmere-wool') {
                catalogHeading.textContent = 'The Cashmere & Wool Edit';
            } else if (activeCollection === 'evening-silk') {
                catalogHeading.textContent = 'Evening Tailoring & Silk';
            } else if (activeCategory !== 'all') {
                catalogHeading.textContent = `${activeCategory} Collection`;
            } else {
                catalogHeading.textContent = 'The Seasonal Edit';
            }

            productGrid.innerHTML = '';

            if (filtered.length === 0) {
                catalogEmpty.classList.remove('hidden');
                return;
            } else {
                catalogEmpty.classList.add('hidden');
            }

