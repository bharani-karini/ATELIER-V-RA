                            </div>

                            <!-- Price Row -->
                            <div class="flex items-baseline gap-2.5">
                                <span class="text-base font-semibold ${p.isOffer ? 'text-terracotta' : 'text-obsidian'}">$${p.price}</span>
                                ${p.originalPrice ? `<span class="text-xs text-mutedInk line-through">$${p.originalPrice}</span>` : ''}
                            </div>

                            <!-- Color Swatches -->
                            <div class="flex items-center justify-between pt-1">
                                <div class="flex items-center gap-2">
                                    ${p.colors.map(c => `
                                        <button 
                                            type="button"
                                            onclick="selectCardColor('${p.id}', '${c.name}')"
                                            aria-label="Select color ${c.name}"
                                            title="${c.name}"
                                            class="w-4 h-4 rounded-full border ${sel.color === c.name ? 'ring-2 ring-offset-2 ring-obsidian border-white' : 'border-obsidian/25'}"
                                            style="background-color: ${c.hex};"
                                        ></button>
                                    `).join('')}
                                </div>
                                <span class="text-[10px] text-mutedInk">${sel.color}</span>
                            </div>

                            <!-- Quick Size Pills -->
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                ${p.sizes.map(sz => `
                                    <button 
                                        type="button"
                                        onclick="selectCardSize('${p.id}', '${sz}')"
                                        class="px-2 py-1 rounded text-[10px] font-semibold border transition-colors ${sel.size === sz ? 'bg-obsidian text-white border-obsidian' : 'bg-alabaster text-charcoal border-obsidian/15 hover:border-obsidian'}"
                                    >
                                        ${sz}
                                    </button>
                                `).join('')}
                            </div>
                        </div>
                    </div>

                    <!-- Card Add to Bag Action -->
                    <div class="px-5 pb-5">
                        <button 
                            type="button"
                            onclick="addToBag('${p.id}', cardSelections['${p.id}'].color, cardSelections['${p.id}'].size, 1)"
                            class="w-full py-3 rounded-full bg-alabaster hover:bg-obsidian text-obsidian hover:text-white border border-obsidian/20 hover:border-obsidian text-[11px] uppercase tracking-[0.2em] font-semibold transition-all duration-300 flex items-center justify-center gap-2"
                        >
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                            <span>Add to Bag</span>
                        </button>
                    </div>
                `;

                productGrid.appendChild(card);
            });

            lucide.createIcons();
        }

        window.selectCardColor = function(productId, colorName) {
            cardSelections[productId].color = colorName;
            renderCatalog();
        };

        window.selectCardSize = function(productId, sizeName) {
            cardSelections[productId].size = sizeName;
            renderCatalog();
        };

        window.filterByCategory = function(cat, shouldScroll = false) {
            activeCategory = cat;
            activeCollection = null;

            document.querySelectorAll('.cat-pill').forEach(btn => {
                if (btn.dataset.cat === cat) {
                    btn.classList.add('bg-obsidian', 'text-white');
                    btn.classList.remove('bg-alabaster', 'text-charcoal');
                } else {
                    btn.classList.remove('bg-obsidian', 'text-white');
                    btn.classList.add('bg-alabaster', 'text-charcoal');
                }
            });

            renderCatalog();
            if (shouldScroll) {
                document.getElementById('catalog').scrollIntoView({ behavior: 'smooth' });
            }
        };

        window.filterByCollection = function(collectionSlug) {
            activeCategory = 'all';
            activeCollection = collectionSlug;
            offerOnlyToggle.checked = false;

            document.querySelectorAll('.cat-pill').forEach(btn => {
                btn.classList.toggle('bg-obsidian', btn.dataset.cat === 'all');
                btn.classList.toggle('text-white', btn.dataset.cat === 'all');
                btn.classList.toggle('bg-alabaster', btn.dataset.cat !== 'all');
                btn.classList.toggle('text-charcoal', btn.dataset.cat !== 'all');
            });

            renderCatalog();
            document.getElementById('catalog').scrollIntoView({ behavior: 'smooth' });
        };

        window.resetCatalogFilters = function() {
            activeCategory = 'all';
            activeCollection = null;
            offerOnlyToggle.checked = false;
            catalogSearch.value = '';
            catalogSort.value = 'featured';
            filterByCategory('all', false);
        };

        document.querySelectorAll('.cat-pill').forEach(btn => {
            btn.addEventListener('click', () => filterByCategory(btn.dataset.cat, false));
        });

        catalogSearch.addEventListener('input', renderCatalog);
        offerOnlyToggle.addEventListener('change', renderCatalog);
        catalogSort.addEventListener('change', renderCatalog);

        window.focusCatalogSearch = function() {
            document.getElementById('catalog').scrollIntoView({ behavior: 'smooth' });
            setTimeout(() => catalogSearch.focus(), 500);
        };

        /* ------------------------------------------
           4. QUICK VIEW PRODUCT MODAL
        ------------------------------------------- */
        const qvModal = document.getElementById('quickview-modal');
        const qvCloseBtn = document.getElementById('qv-close-btn');
        let currentQvProduct = null;
        let qvSelectedColor = '';
        let qvSelectedSize = '';
        let qvQuantity = 1;

        window.openQuickView = function(productId) {
            const p = products.find(item => item.id === productId);
            if (!p) return;

            currentQvProduct = p;
            qvSelectedColor = cardSelections[p.id].color;
            qvSelectedSize = cardSelections[p.id].size;
            qvQuantity = 1;

            document.getElementById('qv-main-img').src = p.images[0];
            document.getElementById('qv-main-img').alt = p.title;
            document.getElementById('qv-badge').textContent = p.badge;
            document.getElementById('qv-badge').className = `absolute top-4 left-4 px-3 py-1 rounded-full text-[10px] uppercase tracking-widest font-bold ${p.isOffer ? 'bg-terracotta text-white' : 'bg-obsidian text-white'}`;
            document.getElementById('qv-category').textContent = `${p.category} • Autumn / Winter 2026`;
            document.getElementById('qv-title').textContent = p.title;
            document.getElementById('qv-fabric').textContent = p.fabric;
            document.getElementById('qv-composition').textContent = p.fabric;
            document.getElementById('qv-description').textContent = p.description;
            document.getElementById('qv-qty').textContent = qvQuantity;

            const qvPrice = document.getElementById('qv-price');
            const qvOrig = document.getElementById('qv-original-price');
            qvPrice.textContent = `$${p.price}`;
            qvPrice.className = `text-2xl font-semibold ${p.isOffer ? 'text-terracotta' : 'text-obsidian'}`;

            if (p.originalPrice) {
                qvOrig.textContent = `$${p.originalPrice}`;
                qvOrig.classList.remove('hidden');
            } else {
                qvOrig.classList.add('hidden');
            }

            // Thumbnails
            document.getElementById('qv-thumbs').innerHTML = p.images.map((img, i) => `
                <button type="button" onclick="document.getElementById('qv-main-img').src='${img}'" class="aspect-[4/3] rounded-xl overflow-hidden border border-obsidian/15 hover:border-gold transition-colors">
                    <img src="${img}" alt="Angle ${i + 1}" class="w-full h-full object-cover" />
                </button>
            `).join('');

            renderQvSelectors();

            document.getElementById('qv-add-btn').onclick = () => {
                addToBag(p.id, qvSelectedColor, qvSelectedSize, qvQuantity);
                closeQuickView();
            };

            qvModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            lucide.createIcons();
        };

        function renderQvSelectors() {
            if (!currentQvProduct) return;
            document.getElementById('qv-selected-color-name').textContent = qvSelectedColor;

            document.getElementById('qv-colors').innerHTML = currentQvProduct.colors.map(c => `
                <button 
                    type="button"
                    onclick="qvSelectedColor='${c.name}'; renderQvSelectors();"
                    class="w-7 h-7 rounded-full border ${qvSelectedColor === c.name ? 'ring-2 ring-offset-2 ring-obsidian border-white' : 'border-obsidian/25'}"
                    style="background-color: ${c.hex};"
                    title="${c.name}"
                ></button>
            `).join('');

            document.getElementById('qv-sizes').innerHTML = currentQvProduct.sizes.map(sz => `
                <button 
                    type="button"
                    onclick="qvSelectedSize='${sz}'; renderQvSelectors();"
                    class="py-2.5 rounded-xl text-xs font-semibold border transition-colors ${qvSelectedSize === sz ? 'bg-obsidian text-white border-obsidian' : 'bg-alabaster text-obsidian border-obsidian/15 hover:border-obsidian'}"
                >
                    ${sz}
                </button>
            `).join('');
        }

        window.adjustQvQty = function(delta) {
            qvQuantity = Math.max(1, qvQuantity + delta);
            document.getElementById('qv-qty').textContent = qvQuantity;
        };

        function closeQuickView() {
            qvModal.classList.add('hidden');
            document.body.style.overflow = '';
        }

        qvCloseBtn.addEventListener('click', closeQuickView);
        qvModal.addEventListener('click', (e) => {
            if (e.target === qvModal) closeQuickView();
        });

        /* ------------------------------------------
           5. SHOPPING BAG DRAWER & CHECKOUT LOGIC
        ------------------------------------------- */
        const bagOverlay = document.getElementById('bag-overlay');
        const bagItemsContainer = document.getElementById('bag-items-container');
        const bagFooter = document.getElementById('bag-footer');
        const checkoutSuccessPanel = document.getElementById('checkout-success-panel');

        function saveBag() {
            localStorage.setItem('vera_bag', JSON.stringify(bag));
            updateBagUI();
        }

        window.addToBag = function(productId, color, size, qty = 1) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existingIndex = bag.findIndex(item => item.id === productId && item.color === color && item.size === size);
            if (existingIndex > -1) {
                bag[existingIndex].qty += qty;
            } else {
                bag.push({
                    id: product.id,
                    title: product.title,
                    price: product.price,
                    image: product.images[0],
                    color,
                    size,
                    qty
                });
            }

            checkoutSuccessPanel.classList.add('hidden');
            bagItemsContainer.classList.remove('hidden');
            bagFooter.classList.remove('hidden');

            saveBag();
            showToast(`Added "${product.title}" (${size}) to your bag`);
        };

        window.updateBagQty = function(index, delta) {
            if (!bag[index]) return;
            bag[index].qty += delta;
            if (bag[index].qty <= 0) {
                bag.splice(index, 1);
            }
            saveBag();
        };

        window.removeBagItem = function(index) {
            bag.splice(index, 1);
            saveBag();
        };

        function updateBagUI() {
            const totalCount = bag.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('bag-badge').textContent = totalCount;
            document.getElementById('drawer-bag-count').textContent = `(${totalCount})`;

            const subtotal = bag.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const discount = promoApplied ? subtotal * 0.20 : 0;
            const discountedSubtotal = subtotal - discount;
            const freeShippingThreshold = 200;
            const shipping = (subtotal === 0 || discountedSubtotal >= freeShippingThreshold) ? 0 : 15;
            const total = discountedSubtotal + shipping;

            // Update Free Shipping Bar
            const progressPct = Math.min(100, (discountedSubtotal / freeShippingThreshold) * 100);
            document.getElementById('shipping-progress-bar').style.width = `${progressPct}%`;
            const remaining = Math.max(0, freeShippingThreshold - discountedSubtotal);
            document.getElementById('shipping-progress-text').innerHTML = discountedSubtotal >= freeShippingThreshold
                ? `<span class="text-emerald-700 font-semibold">You have unlocked Complimentary Express Shipping!</span>`
                : `Add <strong class="text-obsidian">$${remaining.toFixed(2)}</strong> more for complimentary express shipping.`;

            // Render Bag Items
            if (bag.length === 0) {
                bagItemsContainer.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-center py-12 space-y-3">
                        <i data-lucide="shopping-bag" class="w-10 h-10 text-mutedInk/50"></i>
                        <p class="font-serif text-2xl text-obsidian">Your Bag is Empty</p>
                        <p class="text-xs text-mutedInk max-w-xs">Explore our Autumn/Winter 2026 tailoring and cashmere capsules to begin.</p>
                    </div>
                `;
                document.getElementById('checkout-btn').disabled = true;
            } else {
                document.getElementById('checkout-btn').disabled = false;
                bagItemsContainer.innerHTML = bag.map((item, idx) => `
                    <div class="bg-white rounded-2xl p-4 border border-obsidian/10 flex gap-4">
                        <img src="${item.image}" alt="${item.title}" class="w-20 h-24 rounded-xl object-cover bg-warmStone shrink-0" />
                        <div class="flex-1 flex flex-col justify-between">
                            <div>
                                <div class="flex items-start justify-between gap-2">
                                    <h4 class="font-serif text-lg text-obsidian leading-tight">${item.title}</h4>
                                    <button onclick="removeBagItem(${idx})" aria-label="Remove item" class="text-mutedInk hover:text-terracotta">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                                <p class="text-[11px] text-mutedInk mt-0.5">${item.color} &bull; Size ${item.size}</p>
                            </div>
                            <div class="flex items-center justify-between pt-2">
                                <div class="flex items-center border border-obsidian/15 rounded-full px-2 py-0.5">
                                    <button onclick="updateBagQty(${idx}, -1)" class="p-1 text-obsidian hover:text-goldDark"><i data-lucide="minus" class="w-3 h-3"></i></button>
                                    <span class="px-2.5 text-xs font-semibold">${item.qty}</span>
                                    <button onclick="updateBagQty(${idx}, 1)" class="p-1 text-obsidian hover:text-goldDark"><i data-lucide="plus" class="w-3 h-3"></i></button>
                                </div>
                                <span class="text-sm font-semibold text-obsidian">$${(item.price * item.qty).toFixed(2)}</span>
                            </div>
                        </div>
                    </div>
                `).join('');
            }

            // Totals
            document.getElementById('bag-subtotal').textContent = `$${subtotal.toFixed(2)}`;
            const discountRow = document.getElementById('bag-discount-row');
            if (promoApplied && subtotal > 0) {
                discountRow.classList.remove('hidden');
                document.getElementById('bag-discount').textContent = `-$${discount.toFixed(2)}`;
            } else {
                discountRow.classList.add('hidden');
            }
            document.getElementById('bag-shipping').textContent = subtotal === 0 ? '$0.00' : (shipping === 0 ? 'Complimentary' : `$${shipping.toFixed(2)}`);
            document.getElementById('bag-total').textContent = `$${total.toFixed(2)}`;

            lucide.createIcons();
        }

        // Promo Code Form inside Bag
        document.getElementById('bag-promo-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const code = document.getElementById('bag-promo-input').value.trim().toUpperCase();
            const statusMsg = document.getElementById('promo-status-msg');
            statusMsg.classList.remove('hidden');

            if (code === 'VERA20') {
                promoApplied = true;
                statusMsg.textContent = 'Privilege code VERA20 applied (20% off).';
                statusMsg.className = 'text-[11px] mt-1.5 text-emerald-700 font-semibold';
                updateBagUI();
            } else {
                statusMsg.textContent = 'Invalid code. Try VERA20 for 20% off.';
                statusMsg.className = 'text-[11px] mt-1.5 text-terracotta';
            }
        });

        window.openBagDrawer = function() {
            bagOverlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        };

        window.closeBagDrawer = function() {
            bagOverlay.classList.add('hidden');
            document.body.style.overflow = '';
        };

        bagOverlay.addEventListener('click', (e) => {
            if (e.target === bagOverlay) closeBagDrawer();
        });

        window.processCheckout = function() {
            if (bag.length === 0) return;
            const totalText = document.getElementById('bag-total').textContent;
            const itemCount = bag.reduce((s, i) => s + i.qty, 0);

            document.getElementById('checkout-order-summary').textContent = 
                `Order #AV-${Math.floor(100000 + Math.random() * 900000)} (${itemCount} ${itemCount === 1 ? 'piece' : 'pieces'}, Total ${totalText}) is confirmed and queued for express dispatch.`;

            bagItemsContainer.classList.add('hidden');
            bagFooter.classList.add('hidden');
            checkoutSuccessPanel.classList.remove('hidden');

            bag = [];
            promoApplied = false;
            saveBag();
            lucide.createIcons();
        };

        window.resetAfterCheckout = function() {
            checkoutSuccessPanel.classList.add('hidden');
            bagItemsContainer.classList.remove('hidden');
            bagFooter.classList.remove('hidden');
            closeBagDrawer();
        };

        /* ------------------------------------------
           6. WISHLIST DRAWER LOGIC
        ------------------------------------------- */
        const wishlistOverlay = document.getElementById('wishlist-overlay');
        const wishlistItemsContainer = document.getElementById('wishlist-items-container');

        window.toggleWishlist = function(productId) {
            const p = products.find(item => item.id === productId);
            if (!p) return;

            if (wishlist.includes(productId)) {
                wishlist = wishlist.filter(id => id !== productId);
                showToast(`Removed "${p.title}" from wishlist`);
            } else {
                wishlist.push(productId);
                showToast(`Saved "${p.title}" to wishlist`);
            }
            localStorage.setItem('vera_wishlist', JSON.stringify(wishlist));
            updateWishlistUI();
            renderCatalog();
        };

        function updateWishlistUI() {
            document.getElementById('wishlist-badge').textContent = wishlist.length;
            const savedProducts = products.filter(p => wishlist.includes(p.id));

            if (savedProducts.length === 0) {
                wishlistItemsContainer.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-center py-12 space-y-3">
                        <i data-lucide="heart" class="w-10 h-10 text-mutedInk/40"></i>
                        <p class="font-serif text-2xl text-obsidian">No Saved Pieces Yet</p>
                        <p class="text-xs text-mutedInk max-w-xs">Tap the heart icon on any garment to curate your personal wishlist.</p>
                    </div>
                `;
            } else {
                wishlistItemsContainer.innerHTML = savedProducts.map(p => `
                    <div class="bg-white rounded-2xl p-4 border border-obsidian/10 flex gap-4">
                        <img src="${p.images[0]}" alt="${p.title}" class="w-20 h-24 rounded-xl object-cover bg-warmStone shrink-0" />
                        <div class="flex-1 flex flex-col justify-between">
                            <div>
                                <div class="flex items-start justify-between gap-2">
                                    <h4 class="font-serif text-lg text-obsidian leading-tight">${p.title}</h4>
                                    <button onclick="toggleWishlist('${p.id}')" aria-label="Remove from wishlist" class="text-mutedInk hover:text-terracotta">
                                        <i data-lucide="x" class="w-4 h-4"></i>
                                    </button>
                                </div>
                                <p class="text-xs font-semibold text-obsidian mt-1">$${p.price}</p>
                            </div>
                            <button 
                                onclick="addToBag('${p.id}', '${p.colors[0].name}', '${p.sizes.includes('M') ? 'M' : p.sizes[0]}', 1); closeWishlistDrawer(); openBagDrawer();"
                                class="mt-2 py-2 px-4 rounded-full bg-obsidian text-white text-[10px] uppercase tracking-widest font-semibold hover:bg-charcoal transition-colors"
                            >
                                Move to Bag
                            </button>
                        </div>
                    </div>
                `).join('');
            }
            lucide.createIcons();
        }

        window.openWishlistDrawer = function() {
            updateWishlistUI();
            wishlistOverlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        };

        window.closeWishlistDrawer = function() {
            wishlistOverlay.classList.add('hidden');
            document.body.style.overflow = '';
        };

        wishlistOverlay.addEventListener('click', (e) => {
            if (e.target === wishlistOverlay) closeWishlistDrawer();
        });

        /* ------------------------------------------
           7. PROMO COPY, COUNTDOWN TIMER, NEWSLETTER & TOAST
        ------------------------------------------- */
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast-notification');
            document.getElementById('toast-message').textContent = msg;
            toast.classList.remove('hidden');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
            }, 2800);
        }

        window.copyPromoCode = function() {
            const code = 'VERA20';
            const tempInput = document.createElement('input');
            tempInput.value = code;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            const label = document.getElementById('copy-btn-label');
            if (label) {
                label.textContent = 'Copied!';
                setTimeout(() => { label.textContent = 'Copy Code'; }, 2200);
            }
            showToast('Promo code VERA20 copied to clipboard!');
        };

        // Live Countdown Timer (4 days from page load)
        const targetEndTime = Date.now() + (4 * 24 * 60 * 60 * 1000) + (18 * 60 * 60 * 1000);
        function updateCountdown() {
            const diff = Math.max(0, targetEndTime - Date.now());
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const mins = Math.floor((diff / 1000 / 60) % 60);
            const secs = Math.floor((diff / 1000) % 60);

            document.getElementById('cd-days').textContent = String(days).padStart(2, '0');
            document.getElementById('cd-hours').textContent = String(hours).padStart(2, '0');
            document.getElementById('cd-mins').textContent = String(mins).padStart(2, '0');
            document.getElementById('cd-secs').textContent = String(secs).padStart(2, '0');
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();

        // Newsletter Form
        document.getElementById('newsletter-form').addEventListener('submit', (e) => {
            e.preventDefault();
            document.getElementById('newsletter-email').value = '';
            document.getElementById('newsletter-feedback').classList.remove('hidden');
        });

        // Mobile Navigation Drawer
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileOpenIcon = document.getElementById('mobile-open-icon');
        const mobileCloseIcon = document.getElementById('mobile-close-icon');

        mobileMenuBtn.addEventListener('click', () => {
            const isHidden = mobileMenu.classList.contains('hidden');
            mobileMenu.classList.toggle('hidden');
            mobileOpenIcon.classList.toggle('hidden', isHidden);
            mobileCloseIcon.classList.toggle('hidden', !isHidden);
        });

        window.closeMobileMenu = function() {
            mobileMenu.classList.add('hidden');
            mobileOpenIcon.classList.remove('hidden');
            mobileCloseIcon.classList.add('hidden');
        };

        // Escape key closes open modals/drawers
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeQuickView();
                closeBagDrawer();
                closeWishlistDrawer();
            }
        });

        // Initial Boot
        updateBagUI();
        updateWishlistUI();
        renderCatalog();
    </script>
</body>
</html>
