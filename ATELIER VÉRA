                                type="button"
                                onclick="toggleWishlist('${p.id}')"
                                aria-label="Save ${p.title} to Wishlist"
                                class="absolute top-3.5 right-3.5 w-9 h-9 rounded-full bg-white/90 hover:bg-white flex items-center justify-center shadow-sm transition-transform active:scale-90"
                            >
                                <i data-lucide="heart" class="w-4 h-4 ${isWishlisted ? 'fill-terracotta text-terracotta' : 'text-obsidian'}"></i>
                            </button>

                            <!-- Hover Quick View Trigger -->
                            <button 
                                type="button"
                                onclick="openQuickView('${p.id}')"
                                class="absolute bottom-3.5 left-3.5 right-3.5 py-2.5 rounded-full bg-white/95 hover:bg-obsidian text-obsidian hover:text-white text-[11px] uppercase tracking-[0.2em] font-semibold opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 shadow-md"
                            >
                                Quick View
                            </button>
                        </div>

                        <!-- Card Details -->
                        <div class="p-5 space-y-3">
                            <div>
                                <p class="text-[11px] text-mutedInk truncate">${p.fabric}</p>
                                <h3 onclick="openQuickView('${p.id}')" class="font-serif text-xl text-obsidian font-medium mt-0.5 hover:text-goldDark cursor-pointer transition-colors leading-snug">
                                    ${p.title}
